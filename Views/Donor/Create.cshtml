@model BloodBankManagementSystem.Models.Donor

@{
    ViewData["Title"] = "Add Donor";
}

<h2 class="text-center text-danger">Blood Donor Registration</h2>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label>Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Age</label>
        <input asp-for="Age" class="form-control" />
        <span asp-validation-for="Age" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Gender</label>
        <select asp-for="Gender" class="form-control">
            <option value="">Select</option>
            <option>Male</option>
            <option>Female</option>
        </select>
    </div>

    <div class="mb-3">
        <label>Blood Group</label>
        <select asp-for="BloodGroup" class="form-control">
            <option>A+</option>
            <option>A-</option>
            <option>B+</option>
            <option>B-</option>
            <option>AB+</option>
            <option>AB-</option>
            <option>O+</option>
            <option>O-</option>
        </select>
    </div>

    <div class="mb-3">
        <label>Contact</label>
        <input asp-for="Contact" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Email</label>
        <input asp-for="Email" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Address</label>
        <textarea asp-for="Address" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label>Last Donation Date</label>
        <input asp-for="LastDonation" type="date" class="form-control" />
    </div>

    <button type="submit" class="btn btn-danger">
        Save Donor
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Back
    </a>

</form>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}