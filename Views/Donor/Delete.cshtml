@model BloodBankManagementSystem.Models.Donor

@{
    ViewData["Title"] = "Delete Donor";
}

<h2 class="text-danger">Delete Donor</h2>

<h4>Are you sure you want to delete this donor?</h4>

<hr />

<dl class="row">

    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Blood Group</dt>
    <dd class="col-sm-9">@Model.BloodGroup</dd>

    <dt class="col-sm-3">Contact</dt>
    <dd class="col-sm-9">@Model.Contact</dd>

</dl>

<form asp-action="Delete">

    <input type="hidden" asp-for="DonorId" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>