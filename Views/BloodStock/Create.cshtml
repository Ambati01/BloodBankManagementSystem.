@model BloodBankManagementSystem.Models.BloodStock

<h2>Add Blood Stock</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<form asp-action="Create">

    <div class="mb-3">
        <label>Blood Group</label>
        <select asp-for="BloodGroup" class="form-control">
            <option>A+</option>
            <option>A-</option>
            <option>B+</option>
            <option>B-</option>
            <option>AB+</option>
            <option>AB-</option>
            <option>O+</option>
            <option>O-</option>
        </select>
    </div>

    <div class="mb-3">
        <label>Units Available</label>
        <input asp-for="UnitsAvailable" class="form-control" />
    </div>

    <button type="submit" class="btn btn-danger">
        Save
    </button>

</form>