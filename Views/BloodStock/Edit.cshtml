@model BloodBankManagementSystem.Models.BloodStock

<h2>Edit Blood Stock</h2>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="StockId" />

    <div class="mb-3">
        <label>Blood Group</label>
        <select asp-for="BloodGroup" class="form-control">
            <option>A+</option>
            <option>A-</option>
            <option>B+</option>
            <option>B-</option>
            <option>AB+</option>
            <option>AB-</option>
            <option>O+</option>
            <option>O-</option>
        </select>
    </div>

    <div class="mb-3">
        <label>Units Available</label>
        <input asp-for="UnitsAvailable" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">
        Update
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Back
    </a>

</form>