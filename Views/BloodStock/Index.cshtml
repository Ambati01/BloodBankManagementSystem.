```cshtml
@model IEnumerable<BloodBankManagementSystem.Models.BloodStock>

@{
    ViewData["Title"] = "Blood Stock";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Blood Stock List</h2>

        @* Only Admin and Staff can add blood stock *@
        @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
        {
            <a asp-action="Create" class="btn btn-primary">
                Add Blood Stock
            </a>
        }
    </div>

    <table class="table table-bordered table-hover">

        <thead class="table-danger">
            <tr>
                <th>Stock ID</th>
                <th>Blood Group</th>
                <th>Units</th>

                @* Action column only for Admin and Staff *@
                @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
                {
                    <th>Action</th>
                }
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.StockId</td>

                    <td>@item.BloodGroup</td>

                    <td>@item.UnitsAvailable</td>

                    @* Only Admin and Staff can edit/delete *@
                    @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
                    {
                        <td>

                            <a asp-action="Edit"
                               asp-route-id="@item.StockId"
                               class="btn btn-warning btn-sm">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.StockId"
                               class="btn btn-danger btn-sm">
                                Delete
                            </a>

                        </td>
                    }

                </tr>
            }

        </tbody>

    </table>

</div>
```
