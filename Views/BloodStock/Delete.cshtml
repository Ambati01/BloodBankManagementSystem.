@model BloodBankManagementSystem.Models.BloodStock

<h2>Delete Blood Stock</h2>

<h4>Are you sure you want to delete this blood stock?</h4>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="StockId" />

    <p>
        <strong>Blood Group:</strong> @Model.BloodGroup
    </p>

    <p>
        <strong>Units Available:</strong> @Model.UnitsAvailable
    </p>

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>