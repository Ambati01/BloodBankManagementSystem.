@model IEnumerable<BloodBankManagementSystem.Models.BloodRequest>

@{
    ViewData["Title"] = "Blood Requests";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Blood Requests</h2>

        @* Only Admin and Hospital can create requests *@
        @if (User.IsInRole("Admin") || User.IsInRole("Hospital"))
        {
            <a asp-action="Create" class="btn btn-primary">
                New Request
            </a>
        }

    </div>


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    <table class="table table-bordered table-hover">

        <thead class="table-danger">

            <tr>

                <th>ID</th>
                <th>Patient</th>
                <th>Hospital</th>
                <th>Blood Group</th>
                <th>Units</th>
                <th>Status</th>

                @* Show Action column only when a role has actions *@
                @if (User.IsInRole("Admin") ||
                     User.IsInRole("Staff"))
                {
                    <th>Action</th>
                }

            </tr>

        </thead>


        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @item.RequestId
                    </td>

                    <td>
                        @item.PatientName
                    </td>

                    <td>
                        @item.HospitalName
                    </td>

                    <td>
                        @item.BloodGroup
                    </td>

                    <td>
                        @item.UnitsRequired
                    </td>

                    <td>
                        @item.Status
                    </td>


                    @* Admin and Staff actions *@
                    @if (User.IsInRole("Admin") ||
                         User.IsInRole("Staff"))
                    {
                        <td>

                            @* Approve button *@
                            <a asp-action="Approve"
                               asp-route-id="@item.RequestId"
                               class="btn btn-success btn-sm">
                                Approve
                            </a>


                            @* Edit button *@
                            <a asp-action="Edit"
                               asp-route-id="@item.RequestId"
                               class="btn btn-warning btn-sm">
                                Edit
                            </a>


                            @* Delete button *@
                            <a asp-action="Delete"
                               asp-route-id="@item.RequestId"
                               class="btn btn-danger btn-sm">
                                Delete
                            </a>

                        </td>
                    }

                </tr>
            }

        </tbody>

    </table>

</div>