@model BloodBankManagementSystem.Models.BloodRequest

<h2>Delete Request</h2>

<h4>Are you sure you want to delete this request?</h4>

<form asp-action="Delete">

    <input type="hidden" asp-for="RequestId" />

    <p><strong>Patient:</strong> @Model.PatientName</p>

    <p><strong>Blood Group:</strong> @Model.BloodGroup</p>

    <p><strong>Units:</strong> @Model.UnitsRequired</p>

    <button class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>